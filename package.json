{
  "name": "dsh-multiview",
  "version": "0.1.9",
  "description": "Multi-view for DeepSeek Harness: 2-4 live conversations side by side, each pane a real Chat, with resize, swap, saved splits and pane focus.",
  "type": "module",
  "license": "MIT",
  "author": "Awenforever",
  "homepage": "https://github.com/Awenforever/dsh-multiview#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Awenforever/dsh-multiview.git"
  },
  "bugs": {
    "url": "https://github.com/Awenforever/dsh-multiview/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "deepseek",
    "multiview",
    "split-view",
    "split-screen",
    "panel"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.zh.md",
    "CHANGELOG.md",
    "LICENSE",
    "docs/*.md"
  ],
  "engines": {
    "dsh": ">=0.2.1-rc.5 <0.2.2-0 || >=0.2.2-rc.1 <0.3.0"
  },
  "scripts": {
    "build": "node --disable-warning=ExperimentalWarning scripts/build.mjs",
    "check": "node scripts/check.mjs",
    "test": "node --disable-warning=ExperimentalWarning --test test/model.test.ts",
    "prepack": "node --disable-warning=ExperimentalWarning scripts/build.mjs && node scripts/check.mjs"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
